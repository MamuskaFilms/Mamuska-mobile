# Copiá este archivo como ".env" y completá tus propias claves.
# NUNCA subas el archivo ".env" real a GitHub — solo este ".env.example".

# --- Acceso a la app ---
APP_PASSWORD=cambiame-por-una-clave-larga

# --- Anthropic (el Brain) ---
ANTHROPIC_API_KEY=

# --- Airtable (fuente de verdad de datos) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appXdCyqKDwoRWhf8

# --- Google (Drive / Calendar / Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://TU-DOMINIO.onrender.com/auth/google/callback

# --- QuickBooks (Intuit) ---
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
QB_REDIRECT_URI=https://TU-DOMINIO.onrender.com/auth/qb/callback

PORT=3000
